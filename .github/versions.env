# ONNX Runtime publishes no release archive on GitHub any more; CI takes the
# official Microsoft.ML.OnnxRuntime NuGet package instead (headers under
# build/native/include, shared library under runtimes/<rid>/native). Keep this
# in step with the `onnxruntime` package the dev shell gets from nixpkgs.
ORT_VERSION=1.27.1
TOKENIZERS_VERSION=v1.27.0
