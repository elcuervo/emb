{
  // The site's deployment target: an assets-only Worker. There is no `main`,
  // because nothing here runs — the pages are static and the console is a
  // transcript client by spec, not a live RESP endpoint.
  //
  // `website/` is edited and `website/` is published, so what ships is this
  // directory minus `website/.assetsignore`. That is the only boundary between
  // an authoring file and a public URL, which is why
  // `website/tools/published-tree.py` asserts the expected set and runs before
  // every deploy. See openspec/changes/deploy-site-to-cloudflare/.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "emb-site",
  "compatibility_date": "2026-09-13",

  "assets": {
    "directory": "./website",
    // Serve /docs and /docs/ alike: the landing deep-links to
    // `docs/index.html#configuration` and humans type `/docs`.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Preview URLs must stay on so `wrangler versions upload --preview-alias`
  // can hand a pull request a stable address before it merges.
  "preview_urls": true,
  "workers_dev": true,

  // The production origin. Declared here — rather than attached once by hand —
  // so every deploy from `main` keeps it attached and a rollback restores it.
  //
  // It was first attached only after the served tree was audited on the
  // workers.dev address, so a mistake in `.assetsignore` was never public;
  // that audit is tasks 7.1–7.2 of `deploy-site-to-cloudflare`, and this
  // declaration is 7.3. Attaching at the apex replaces the `emb-placeholder`
  // Worker that held `emb.is` while the site was being built.
  "routes": [{ "pattern": "emb.is", "custom_domain": true }]
}
