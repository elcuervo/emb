#!/usr/bin/env ruby
# frozen_string_literal: true

# emb-stress: synthetic embedding load for a running emb fleet. Pure RESP
# client — no onnxruntime dependency (unlike bin/emb).

spec = Gem::Specification.find_by_name('emb-server')

binary_name = case RUBY_PLATFORM
              when /arm64.*darwin/  then 'emb-stress-binary-arm64-darwin'
              when /x86_64.*linux/  then 'emb-stress-binary-x86_64-linux'
              when /aarch64.*linux/ then 'emb-stress-binary-aarch64-linux'
              else
                warn "ERROR: unsupported platform #{RUBY_PLATFORM}"
                exit 1
              end

binary = File.join(spec.gem_dir, 'lib', 'emb-server', binary_name)

unless File.exist?(binary)
  warn "ERROR: binary not found at #{binary}"
  exit 1
end

exec binary, *ARGV
