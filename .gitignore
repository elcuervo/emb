# Kitchensink example: the state directory holding its Redis index and pidfiles.
/examples/kitchensink/.state/

# Generated by `just website-dev` (local model paths + ports).
/website/repl/.sandbox-dev.yaml

# Generated by `just website-demos` (local model paths + the build port).
/website/repl/.sandbox-index.yaml

# Project Gutenberg volumes cached by `website/tools/demos/fetch-poe.py`. The
# committed artifact is poe.jsonl; the sources are re-fetchable and large.
/website/tools/demos/.cache/

# A recording rig's output: the raw cast, the trimmed take, the node log and the
# machine-readable sample log. Kept on disk as the provenance for the plate
# `just website-topviz` publishes, but not committed -- a 700KB cast per take is
# history nobody reads twice.
/website/tools/topviz/runs/
